# ─── استراحة الجود — متغيرات البيئة ───
# انسخ هذا الملف إلى server/.env للتطوير المحلي. لا ترفع ملف .env إلى GitHub أبدًا.

# development | test | production
NODE_ENV=development

# منفذ الخادم (Render يحدده تلقائيًا في الإنتاج)
PORT=4000

# رابط قاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://jood:CHANGE_ME@localhost:5432/jood_dev?schema=public

# سر توقيع جلسات الإدارة — 32 حرفًا على الأقل
# أنشئه بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# الرابط العام للموقع (يُستخدم لبناء روابط الضيوف الخاصة)
PUBLIC_BASE_URL=http://localhost:5173

# ─── إشعارات واتساب للمالك (اختياري) — WhatsApp Business Cloud API من Meta ───
# اتركها فارغة حتى يتوفر حساب WhatsApp Business API. الإشعار داخل لوحة الإدارة يعمل بدونها.
# رقم واتساب المالك وتفعيل الإرسال يُضبطان من لوحة الإدارة (الإعدادات ← الإشعارات).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# اسم قالب الرسالة المعتمد من Meta (مطلوب للرسائل التي يبدأها النظام)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_API_VERSION=v22.0
